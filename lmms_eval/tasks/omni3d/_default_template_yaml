# Common configuration for all Omni3D tasks
# Note: We use a local dummy dataset file, actual data is loaded in process_docs
dataset_path: json
test_split: test
output_type: generate_until
doc_to_visual: !function utils.omni3d_doc_to_visual
doc_to_text: !function utils.omni3d_doc_to_text
doc_to_target: "category"

process_results: !function utils.omni3d_process_results
process_docs: !function utils.omni3d_process_docs

metric_list:
  - metric: omni3d_valid_rate
    aggregation: !function utils.omni3d_aggregate_results
    higher_is_better: true
  - metric: omni3d_recall_proxy
    aggregation: !function utils.omni3d_recall_proxy_agg
    higher_is_better: true
  - metric: omni3d_ap3d
    aggregation: !function utils.omni3d_ap3d_agg
    higher_is_better: true
  - metric: omni3d_ap3d_15
    aggregation: !function utils.omni3d_ap3d_15_agg
    higher_is_better: true
  - metric: omni3d_ap3d_25
    aggregation: !function utils.omni3d_ap3d_25_agg
    higher_is_better: true
  - metric: omni3d_ap3d_50
    aggregation: !function utils.omni3d_ap3d_50_agg
    higher_is_better: true
  - metric: omni3d_ar3d_1
    aggregation: !function utils.omni3d_ar3d_1_agg
    higher_is_better: true
  - metric: omni3d_ar3d_10
    aggregation: !function utils.omni3d_ar3d_10_agg
    higher_is_better: true
  - metric: omni3d_ar3d_100
    aggregation: !function utils.omni3d_ar3d_100_agg
    higher_is_better: true

generation_kwargs:
  max_new_tokens: 2048
  temperature: 0.0
  do_sample: false
  until:
    - "<|im_end|>"
    - "<|endoftext|>"
    - "</s>"

dataset_kwargs:
  data_files:
    test: lmms_eval/tasks/omni3d/dummy_dataset.json
  token: False

metadata:
  version: 1.0
  description: "3D object detection from single RGB images"
  paper: "Omni3D: A Large Benchmark and Model for 3D Object Detection in the Wild"
  url: "https://github.com/facebookresearch/omni3d"
